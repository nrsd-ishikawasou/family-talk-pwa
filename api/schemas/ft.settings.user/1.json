{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-talk.invalid/schemas/ft.settings.user/1",
  "title": "ft.settings.user/1",
  "description": "第2章 12。構成員ごとの設定（/me/settings）。api/config.yaml から生成",
  "type": "object",
  "properties": {
    "notify_content": {
      "type": "string",
      "enum": [
        "name_and_body",
        "name_only",
        "none"
      ],
      "default": "name_and_body",
      "description": "第7章 5.2"
    },
    "muted_users": {
      "type": "array",
      "default": [],
      "description": "第7章 6。通知を出さない人"
    },
    "mention_overrides_mute": {
      "type": "boolean",
      "default": true,
      "description": "第7章 6"
    },
    "badge_includes_muted": {
      "type": "boolean",
      "default": true,
      "description": "第7章 5.3"
    },
    "tz": {
      "type": "string",
      "default": "Asia/Tokyo",
      "description": "第7章 6。翌朝 8 時の判定"
    },
    "receive_calls": {
      "type": "boolean",
      "default": true,
      "description": "第7章 6。偽で CALL-005"
    },
    "typing_indicator": {
      "type": "boolean",
      "default": true,
      "description": "第4章 DD-4-5。入力中を相手に知らせる"
    },
    "read_receipts": {
      "type": "boolean",
      "default": true,
      "description": "第4章 5.4。既読を相手に知らせる（相互）"
    },
    "url_preview": {
      "type": "boolean",
      "default": true,
      "description": "第4章 DD-4-7"
    },
    "enter_to_send": {
      "type": "boolean",
      "default": true,
      "description": "第10章 8。PC"
    },
    "chat_background": {
      "type": "string",
      "default": "",
      "description": "第10章 8。全体の背景"
    },
    "send_quality": {
      "type": "string",
      "enum": [
        "standard",
        "high",
        "original"
      ],
      "default": "standard",
      "description": "第5章 4.1"
    },
    "auto_download": {
      "type": "object",
      "default": {
        "photo": {
          "wifi": true,
          "mobile": false
        },
        "video": {
          "wifi": true,
          "mobile": false
        },
        "file": {
          "wifi": true,
          "mobile": false
        },
        "audio": {
          "wifi": true,
          "mobile": true
        }
      },
      "description": "第5章 5.2"
    },
    "video_autoplay": {
      "type": "string",
      "enum": [
        "always",
        "wifi",
        "never"
      ],
      "default": "wifi",
      "description": "第5章 5.2。動きを減らす設定の時は never"
    },
    "sticker_animation": {
      "type": "boolean",
      "default": true,
      "description": "第5章 5.2。動きを減らす設定の時は偽"
    },
    "call_quality": {
      "type": "string",
      "enum": [
        "high",
        "wifi_high",
        "standard"
      ],
      "default": "standard",
      "description": "第6章 5.1"
    },
    "call_data_saver": {
      "type": "string",
      "enum": [
        "off",
        "mobile",
        "always"
      ],
      "default": "off",
      "description": "第6章 5.1。iPhone は off と always"
    },
    "ringtone": {
      "type": "string",
      "default": "default",
      "description": "第10章 8、第6章。iPhone と PC。Android は OS"
    }
  },
  "additionalProperties": false
}
