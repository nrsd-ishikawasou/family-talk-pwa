      "$ref": "../common/base64url/1.json"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "alg": {
      "const": "A256GCM"
    },
    "nonce": {
      "$ref": "../common/base64url/1.json"
    },
    "ciphertext": {
      "$ref": "../common/base64url/1.json"
    },
    "created_at": {
      "$ref": "../common/rfc3339/1.json"
    }
  },
  "required": [
    "v",
    "user_id",
    "group_id",
    "epoch",
    "alg",
    "nonce",
    "ciphertext",
    "created_at"
