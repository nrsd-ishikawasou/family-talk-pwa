{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-talk.invalid/schemas/fkb-history/1",
  "title": "fkb-history/1",
  "description": "第12章 12、5.6。鍵のバックアップ",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "user_id": {
