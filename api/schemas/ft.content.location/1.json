{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-talk.invalid/schemas/ft.content.location/1",
  "title": "ft.content.location/1",
  "description": "第4章 3.1、第5章 8.2",
  "type": "object",
  "properties": {
    "replaces": {
      "$ref": "../common/uuidv7/1.json"
    },
    "inReplyTo": {
      "$ref": "../common/uuidv7/1.json"
    },
    "expires": {
      "$ref": "../common/rfc3339/1.json"
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "label": {
      "type": "string"
    },
    "zoom": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "lat",
    "lon"
  ],
  "additionalProperties": false
}
